# ============================================================
# Root Environment Variables (.env)
# 複製此檔案為 .env，填入你的值
# ============================================================

# ┌──────────────────────────────────────────────────────────┐
# │ Supabase                                                 │
# │ 取得方式：                                                │
# │   1. 登入 https://supabase.com/dashboard                 │
# │   2. 選擇你的專案                                         │
# │   3. 左側選單 → Settings → API                           │
# │   4. 頁面上方可看到 Project URL 和 API Keys               │
# └──────────────────────────────────────────────────────────┘

# Project Reference ID（URL 中 supabase.co 前面那段，如 "ybhlybmasoxshzkcaohj"）
# 位置：Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=

# Project URL（完整 URL，如 "https://ybhlybmasoxshzkcaohj.supabase.co"）
# 位置：Settings → API → Project URL
VITE_SUPABASE_URL=

# anon / public key（前端可安全暴露的 key，用於 Row Level Security）
# 位置：Settings → API → Project API keys → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=

# service_role key（擁有繞過 RLS 的完整權限，僅開發用）
# 位置：Settings → API → Project API keys → service_role（點 Reveal 顯示）
# ⚠️ 正式環境不應在前端暴露此 key
VITE_SUPABASE_SERVICE_ROLE_KEY=

# ┌──────────────────────────────────────────────────────────┐
# │ Auth 開發設定                                             │
# └──────────────────────────────────────────────────────────┘

# 設為 "true" 可跳過 Supabase 登入，方便本地開發
VITE_DEV_BYPASS_AUTH=false

# ┌──────────────────────────────────────────────────────────┐
# │ Backend API                                               │
# │ FastAPI 後端的完整 URL（含 /api/v1 prefix）               │
# │ 本地開發預設 http://localhost:8000/api/v1                  │
# └──────────────────────────────────────────────────────────┘

VITE_API_BASE_URL=http://localhost:8000/api/v1

# ┌──────────────────────────────────────────────────────────┐
# │ LLM API Keys                                              │
# │ 以下 key 主要由後端 (backend/.env) 使用                    │
# │ 放在根目錄 .env 是為了讓部分開發工具/腳本也能讀取           │
# └──────────────────────────────────────────────────────────┘

# Anthropic Claude API（必填 — 所有 AI 功能的核心引擎）
# 取得方式：
#   1. 登入 https://console.anthropic.com
#   2. 左側選單 → API Keys → Create Key
#   3. 複製 sk-ant-api03-... 開頭的 key
# 計費：按 token 用量計費，詳見 https://anthropic.com/pricing
ANTHROPIC_API_KEY=

# OpenAI API（選填 — 備用 LLM / embeddings）
# 取得方式：
#   1. 登入 https://platform.openai.com
#   2. 左側選單 → API Keys → Create new secret key
#   3. 複製 sk-... 開頭的 key
# 計費：按 token 用量計費，詳見 https://openai.com/pricing
# 目前用途：未來 RAG embedding (text-embedding-3-small) 或備用 LLM
OPENAI_API_KEY=

# ┌──────────────────────────────────────────────────────────┐
# │ Tavily Web Search API（選填 — AI 建議的證據佐證）          │
# │ 用途：AI 產出約束/KPI 建議時，即時搜尋 ISO 標準、法規、    │
# │       業界 benchmark 作為佐證來源，避免 AI 幻覺            │
# │ 取得方式：                                                │
# │   1. 註冊 https://tavily.com                              │
# │   2. Dashboard → API Keys → 複製 tvly-... 開頭的 key      │
# │ 計費：免費方案 1,000 次搜尋/月，付費方案詳見官網            │
# │ 不填 = AI 功能正常運作，但建議不會附帶外部參考來源          │
# └──────────────────────────────────────────────────────────┘

TAVILY_API_KEY=

# ┌──────────────────────────────────────────────────────────┐
# │ Backend-only Supabase Config                              │
# │ 用於 FastAPI 後端 pydantic-settings 讀取                  │
# │ Docker 部署時，後端容器會使用這些變數                       │
# └──────────────────────────────────────────────────────────┘

# 後端使用的 Supabase URL（與 VITE_SUPABASE_URL 相同值）
SUPABASE_URL=

# 後端使用的 service role key（與 VITE_SUPABASE_SERVICE_ROLE_KEY 相同值）
SUPABASE_SERVICE_KEY=
