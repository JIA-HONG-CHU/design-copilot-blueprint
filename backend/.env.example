# ============================================================
# Backend Environment Variables (backend/.env)
# 複製此檔案為 .env，填入你的值
# ============================================================

# ┌──────────────────────────────────────────────────────────┐
# │ Supabase（與前端同一個專案）                               │
# │ 取得方式：                                                │
# │   1. 登入 https://supabase.com/dashboard                 │
# │   2. 選擇你的專案 → Settings → API                       │
# └──────────────────────────────────────────────────────────┘

# Project URL（如 "https://ybhlybmasoxshzkcaohj.supabase.co"）
SUPABASE_URL=

# service_role key（後端用，擁有完整資料庫存取權限）
# 位置：Settings → API → Project API keys → service_role
SUPABASE_SERVICE_KEY=

# ┌──────────────────────────────────────────────────────────┐
# │ Anthropic Claude API（必填 — 所有 AI 功能的核心）          │
# │ 取得方式：                                                │
# │   1. 登入 https://console.anthropic.com                  │
# │   2. 左側選單 → API Keys → Create Key                    │
# │   3. 複製 sk-ant-api03-... 開頭的 key                     │
# │ 計費：按 token 計費，詳見 https://anthropic.com/pricing   │
# └──────────────────────────────────────────────────────────┘

ANTHROPIC_API_KEY=

# 主要模型（用於 Brief 改寫、約束建議、KPI 建議、TRIZ 等結構化任務）
# 可選值：claude-sonnet-4-6（推薦，性價比最高）、claude-opus-4-6（最強但較貴）
DEFAULT_MODEL=claude-sonnet-4-6

# 快速模型（用於簡單分類、格式化等低延遲任務）
# 可選值：claude-haiku-4-5（最快最便宜）
FAST_MODEL=claude-haiku-4-5

# ┌──────────────────────────────────────────────────────────┐
# │ Tavily Web Search API（選填 — 啟用 AI 建議的證據佐證）     │
# │ 用途：AI 產出約束/KPI 建議時，即時搜尋 ISO 標準、法規、    │
# │       業界 benchmark 作為佐證，避免幻覺                    │
# │ 取得方式：                                                │
# │   1. 註冊 https://tavily.com                              │
# │   2. Dashboard → API Keys → 複製 tvly-... 開頭的 key      │
# │ 計費：免費方案 1,000 次搜尋/月，付費方案詳見官網            │
# │ 不填此欄 = AI 功能正常運作，但建議不會附帶外部參考來源      │
# └──────────────────────────────────────────────────────────┘

TAVILY_API_KEY=

# ┌──────────────────────────────────────────────────────────┐
# │ TRIZ Knowledge Base（本地路徑）                            │
# │ 指向 TRIZ 矛盾矩陣和發明原則的知識庫資料夾                 │
# │ 預設為 backend 同層級的 rd_assistant_design_system 專案    │
# └──────────────────────────────────────────────────────────┘

TRIZ_KB_PATH=../rd_assistant_design_system/triz_knowledge_base

# ┌──────────────────────────────────────────────────────────┐
# │ App 設定                                                  │
# └──────────────────────────────────────────────────────────┘

# 開啟 debug 模式（顯示詳細錯誤訊息）
DEBUG=true

# 允許的前端 CORS 來源（JSON 陣列格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
